# Leave blank to run fully offline: embeddings use LocalTfidfEmbeddings and
# generation uses MockProvider, with no API key or network required.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# auto | openai | anthropic | mock
LLM_PROVIDER=auto
# auto | openai | huggingface | local-tfidf-svd
EMBEDDING_PROVIDER=auto
MODEL_NAME=

CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K=4
UPLOAD_DIR=./uploaded_docs
